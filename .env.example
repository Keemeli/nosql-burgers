# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit the token.

# Database API endpoint (NOT the per-collection URL from the old Document API).
# Astra Portal -> your database -> Database Details / Connection details -> API endpoint
#   https://<DATABASE_ID>-<REGION>.apps.astra.datastax.com
ASTRA_API_ENDPOINT=

# Keyspace and collection the app reads and writes
ASTRA_KEYSPACE=burgers
ASTRA_COLLECTION=burger_info

# Application token (starts with "AstraCS:"), from Connection details -> Generate Token
# or Settings -> Tokens. Needs the Database Administrator role.
ASTRA_TOKEN=

# API port
PORT=8000

# Set to 1 to run against an in-memory store instead of Astra (UI development only)
USE_MOCK=
