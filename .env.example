# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit the token.

# Collection endpoint from the Astra DB UI:
#   https://<DATABASE_ID>-<REGION>.apps.astra.datastax.com/api/rest/v2/namespaces/burgers/collections/burger_info
ASTRA_ENDPOINT=

# Application token with the Database Administrator role (starts with "AstraCS:")
ASTRA_TOKEN=

# API port
PORT=8000

# Set to 1 to run against an in-memory store instead of Astra (UI development only)
USE_MOCK=
